    [ "flame1:VCC", "esp:3V3", "red", [] ],
    [ "flame1:GND", "esp:GND.1", "black", [] ],
    [ "flame1:AO", "esp:35", "orange", [] ],

    [ "buzzer1:1", "esp:25", "purple", [] ],
    [ "buzzer1:2", "esp:GND.1", "black", [] ],

    [ "r1:1", "esp:26", "blue", [] ],
    [ "r1:2", "led1:A", "blue", [] ],
    [ "led1:C", "esp:GND.1", "black", [] ]
