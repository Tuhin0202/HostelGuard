    { "type": "wokwi-dht22", "id": "dht1", "top": -190, "left": -280, "attrs": {} },
    { "type": "wokwi-gas-sensor", "id": "gas1", "top": -190, "left": 140, "attrs": { "ppm": "400" } },
    { "type": "wokwi-photoresistor-sensor", "id": "flame1", "top": 40, "left": -340, "attrs": {} },
    { "type": "wokwi-buzzer", "id": "buzzer1", "top": 60, "left": 240, "attrs": { "volume": "0.2" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 190, "left": 160, "attrs": { "value": "220" } },
